{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "css": "/home/arch12/.config/swaync/colors.conf",
  "positionY": "top",
	"cssPriority": "user",

  "control-center-width": 380,
  "control-center-height": 500, 
  "control-center-margin-top": 2,
  "control-center-margin-bottom": 2,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,

  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,

  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "scripts": {
    "example-script": {
      "exec": "echo 'Do something...'",
      "urgency": "Normal"
    }
  },
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
    },
  "widgets": [
    "label",
    "buttons-grid",
    "title",
    "dnd",
    "notifications",
    "volume"
  ],
    "volume": {
      "label": "",
      "show-per-app-icon": true,
      "show-per-app": true
    },
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " 󰎟 "
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label": {
      "max-lines": 1,
      "text": " "
    },

    "volume": {
      "label": "󰕾",
        "show-per-app": true
    },
    "buttons-grid": {
      "actions": [
        {
      "label": "",
      "exec": "bash -c 'SSID=$(nmcli -t -f active,ssid dev wifi | grep ^yes | cut -d: -f2); [ -z \"$SSID\" ] && SSID=\"Disconnected\"; echo \" $SSID\"'",
      "command": "nm-connection-editor"
    },
    {
      "label": "󰂯",
      "exec": "bash -c 'BT=$(bluetoothctl devices Connected | cut -d\" \" -f3-); [ -z \"$BT\" ] && BT=\"Off\"; echo \"󰂯 $BT\"'",
      "command": "blueman-manager"
    },
        {
          "label": "󰏘",
          "command": "nwg-look"
        },
         {
          "label": "",
          "command": "~/.config/waybar/scripts/powermenu.sh"
        },
        {
          "label": "",
          "command": "~/.config/waybar/scripts/screenshot.sh"
        }
        
      ]
    }
  }
}
